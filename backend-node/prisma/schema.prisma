datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String        @id @default(uuid())
  email        String        @unique
  passwordHash String
  name         String?
  username     String?       @unique
  institution  String?
  discipline   String?
  orcidId      String?
  bio          String?
  settingsJson String?       // JSON of methodological defaults
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  surveys      Survey[]
  activityLogs ActivityLog[]
}

model ActivityLog {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action     String   // "STUDY_CREATED", "PIPELINE_EXECUTED", "DATA_INGESTED", "SETTINGS_UPDATED", "PASSWORD_CHANGED"
  details    String
  entityId   String?
  entityType String?
  createdAt  DateTime @default(now())
}

model Survey {
  id          String        @id @default(uuid())
  title       String
  description String?
  objective   String?
  archetype   String?       // "csat", "product_market_fit", "behavioral", "employee"
  status      String        @default("DRAFT") // "DRAFT", "ACTIVE", "ANALYZED", "ARCHIVED"
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  userId      String?
  user        User?         @relation(fields: [userId], references: [id])
  questions   Question[]
  responses   Response[]
  analysisRuns AnalysisRun[]
}

model Question {
  id          String   @id @default(uuid())
  surveyId    String
  survey      Survey   @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  code        String   // e.g. "q1", "q2"
  title       String
  type        String   // "likert", "multiple_choice", "numeric", "open_ended"
  optionsJson String?  // JSON stringified array of options or scale metadata
  required    Boolean  @default(true)
  orderIndex  Int      @default(0)
}

model Response {
  id              String   @id @default(uuid())
  surveyId        String
  survey          Survey   @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  respondentId    String?
  durationSeconds Float?
  source          String   @default("native") // "native", "google_forms", "qualtrics", "synthetic"
  dataJson        String   // JSON containing key-value pairs of response answers
  isFlagged       Boolean  @default(false)
  flagReason      String?
  createdAt       DateTime @default(now())
}

model AnalysisRun {
  id              String   @id @default(uuid())
  surveyId        String
  survey          Survey   @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  runName         String
  totalResponses  Int
  cleanResponses  Int
  cleanRate       Float
  flaggedSpeeders Int      @default(0)
  flaggedStraightliners Int @default(0)
  preprocessedDataJson String // Versioned cleaned dataset
  auditLogJson    String?  // JSON array of audit logs
  resultsJson     String?  // Full aggregated snapshot (clusters, stats, NLP)
  createdAt       DateTime @default(now())
  hypothesisTests HypothesisTest[]
  clusterResults  ClusterResult[]
  themeResults    ThemeResult[]
}

model HypothesisTest {
  id              String      @id @default(uuid())
  analysisRunId   String
  analysisRun     AnalysisRun @relation(fields: [analysisRunId], references: [id], onDelete: Cascade)
  testUsed        String      // "Welch's t-Test", "Mann-Whitney U", "ANOVA", "Chi-Square", "Fisher's", "Pearson", "Spearman"
  independentVar  String
  dependentVar    String
  statistic       Float
  pValue          Float
  effectSizeName  String
  effectSizeValue Float
  effectSizeMag   String      // "Small", "Medium", "Large"
  isSignificantRaw       Boolean
  isSignificantBonferroni Boolean
  isSignificantBH        Boolean @default(false)
  bhAdjustedPValue       Float?
  executiveSummary       String
  groupStatsJson         String? // JSON of group-level descriptives
  createdAt       DateTime @default(now())
}

model ClusterResult {
  id              String      @id @default(uuid())
  analysisRunId   String
  analysisRun     AnalysisRun @relation(fields: [analysisRunId], references: [id], onDelete: Cascade)
  method          String      // "kmeans", "hierarchical"
  nClusters       Int
  silhouetteScore Float
  pcaVarianceJson String?     // JSON array of variance explained percentages
  clustersJson    String      // JSON array of cluster profiles (name, count, traits)
  pointsJson      String?     // JSON array of 2D scatter points
  createdAt       DateTime @default(now())
}

model ThemeResult {
  id              String      @id @default(uuid())
  analysisRunId   String
  analysisRun     AnalysisRun @relation(fields: [analysisRunId], references: [id], onDelete: Cascade)
  title           String
  keywords        String      // JSON array of keyword strings
  count           Int
  percentage      Float
  sentimentBreakdownJson String // JSON {"positive_pct", "negative_pct", "neutral_pct"}
  representativeQuotesJson String? // JSON array of {quote, sentiment}
  createdAt       DateTime @default(now())
}
